@{ViewData["Title"]="SQL Injection";}
<div class="container py-5"><a asp-controller="Home" asp-action="Index">← Voltar</a><h1 class="mt-3">SQL Injection</h1><p class="lead">Compare consulta vulnerável e protegida.</p><div class="alert alert-warning">Laboratório local. Usuário fictício: joao / demo123.</div>
<div class="card p-4 shadow-sm mb-4"><form method="post" asp-action="Index"><div class="mb-3"><label class="form-label">Usuário</label><input name="usuario" class="form-control" value="@(ViewBag.Usuario??"joao")" required /></div><div class="mb-3"><label class="form-label">Senha</label><input name="senha" class="form-control" value="@(ViewBag.Senha??"demo123")" required /></div><button class="btn btn-primary">Testar as duas consultas</button></form></div>
@if(ViewBag.Vulneravel!=null){<div class="row g-3"><div class="col-md-6"><div class="card border-danger p-3"><h3 class="text-danger">Consulta vulnerável</h3><h4>@((bool)ViewBag.Vulneravel?"Acesso aceito":"Login recusado")</h4><p>SQL concatenado com entrada.</p></div></div><div class="col-md-6"><div class="card border-success p-3"><h3 class="text-success">Consulta segura</h3><h4>@((bool)ViewBag.Seguro?"Credenciais reconhecidas":"Login recusado")</h4><p>Entrada enviada por parâmetros.</p></div></div></div><div class="alert alert-info mt-4"><strong>Conclusão:</strong> parâmetros tratam a entrada como dado, não como SQL.</div>}
<div class="alert alert-secondary mt-4">Teste: usuário <code>' OR 1=1 --</code> e senha <code>qualquercoisa</code>. Exemplo didático, não é autenticação real.</div></div>