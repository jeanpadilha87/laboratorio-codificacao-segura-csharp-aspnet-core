@{ViewData["Title"]="XSS";}
<div class="container py-5"><a asp-controller="Home" asp-action="Index">← Voltar</a><h1 class="mt-3">Cross-Site Scripting (XSS)</h1><p class="lead">Compare o tratamento de um comentário.</p><div class="alert alert-warning">Laboratório local. Use somente a amostra benigna abaixo; não cole scripts ou dados não confiáveis.</div>
<div class="card p-4 shadow-sm"><label for="comentario" class="form-label">Comentário</label><input id="comentario" class="form-control" value="Olá! &lt;b&gt;Texto em destaque&lt;/b&gt;"/><button id="executar" class="btn btn-primary mt-3 align-self-start">Comparar resultados</button></div>
<div class="row g-3 mt-2"><div class="col-md-6"><div class="card border-danger p-3"><h3 class="text-danger">Exibição vulnerável</h3><p>innerHTML interpreta HTML.</p><div id="saidaInsegura" class="border rounded p-3">Resultado aqui.</div></div></div><div class="col-md-6"><div class="card border-success p-3"><h3 class="text-success">Exibição segura</h3><p>textContent apresenta conteúdo como texto.</p><div id="saidaSegura" class="border rounded p-3">Resultado aqui.</div></div></div></div>
<div class="alert alert-info mt-4"><strong>Conclusão:</strong> use APIs seguras como <code>textContent</code> e codificação contextual. Razor codifica expressões comuns; evite <code>Html.Raw</code> com entrada não confiável.</div></div>
@section Scripts {<script>document.getElementById("executar").addEventListener("click",()=>{const value=document.getElementById("comentario").value;document.getElementById("saidaInsegura").innerHTML=value;document.getElementById("saidaSegura").textContent=value;});</script>}