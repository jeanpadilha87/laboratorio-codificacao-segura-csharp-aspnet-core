@{ViewData["Title"]="CSRF";}
<div class="container py-5"><a asp-controller="Home" asp-action="Index">← Voltar</a><h1 class="mt-3">Cross-Site Request Forgery (CSRF)</h1><p class="lead">Proteção de um formulário fictício de alteração de e-mail.</p><div class="alert alert-warning">Sem conta real nem persistência.</div>
@if(ViewBag.Resultado!=null){<div class="alert alert-success">@ViewBag.Resultado</div>}
<div class="card p-4 shadow-sm"><h3>Perfil de demonstração</h3><p>E-mail atual: <strong>@(ViewBag.Email??"joao@exemplo.test")</strong></p><form method="post" asp-action="AlterarEmail"><div class="mb-3"><label class="form-label" for="email">Novo e-mail</label><input id="email" name="email" type="email" class="form-control" required value="@(ViewBag.Email??"joao@exemplo.test")"/></div><button class="btn btn-primary">Enviar com token válido</button></form></div>
<div class="card p-4 mt-4"><h3>Teste sem token</h3><p>Esta rota de simulação rejeita a tentativa e não altera nada.</p><button id="test" class="btn btn-outline-danger">Simular envio sem token</button><div id="resultado" class="mt-3" role="status"></div></div>
<div class="alert alert-info mt-4"><strong>Conclusão:</strong> em formulários autenticados por cookies, valide tokens antifalsificação. Autorização e validação continuam necessárias.</div></div>
@section Scripts {<script>document.getElementById("test").addEventListener("click",async()=>{const r=await fetch('@Url.Action("SimularSemToken","Csrf")',{method:"POST",credentials:"same-origin"});const b=document.getElementById("resultado");b.textContent=r.status===400?"Simulação rejeitada (HTTP 400). Nenhum dado foi alterado.":"Resposta HTTP "+r.status;b.className="alert alert-success mt-3";});</script>}